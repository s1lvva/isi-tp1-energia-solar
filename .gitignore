# Downloads originais das fontes (volume grande; o ETL volta a obtê-los)
data/raw/*
!data/raw/.gitkeep

# Dados gerados pelo ETL
data/processed/*
!data/processed/.gitkeep

# Logs de execução
logs/*
!logs/.gitkeep

# Segredos
.env

# Pentaho (ficheiros temporários e locais)
*.ktr.bak
*.kjb.bak
.kettle/
kettle.properties
repositories.xml

# Node-RED (credenciais e cache)
node-red/.config.*.json
node-red/*_cred.json
node-red/node_modules/

# Sistema operativo
.DS_Store
Thumbs.db
desktop.ini
